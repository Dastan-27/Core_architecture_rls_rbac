# =============================================================================
#  CORE ARCHITECTURE — RLS & RBAC  |  Coleccion HTTP para Integracion
#  Compatible con: VS Code "REST Client" (Huachao Mao) · Thunder Client
# =============================================================================
#  INSTRUCCIONES RAPIDAS
#  1. Instala la extension "REST Client" en VS Code (ID: humao.rest-client)
#  2. Ejecuta primero el seed:   npm run seed
#  3. Inicia el servidor:        npm run start:dev
#  4. Abre este archivo y haz clic en "Send Request" encima de cada bloque.
#  5. Copia el access_token del login y pegalo en @ACCESS_TOKEN abajo.
# =============================================================================

# Variables Globales
@BASE_URL = http://localhost:3001

# Reemplaza estos valores luego de hacer login:
@ACCESS_TOKEN  = PEGA_TU_ACCESS_TOKEN_AQUI
@REFRESH_TOKEN = PEGA_TU_REFRESH_TOKEN_AQUI

# IDs del Seed (Tech Solutions SAS - Tenant 1)
@TENANT_1_ID  = a1000000-0000-4000-8000-000000000001
@BRANCH_1A_ID = b1000000-0000-4000-8000-000000000001
@BRANCH_1B_ID = b1000000-0000-4000-8000-000000000002

# IDs del Seed (Comercializadora Andina SAS - Tenant 2)
@TENANT_2_ID  = a2000000-0000-4000-8000-000000000002
@BRANCH_2_ID  = b2000000-0000-4000-8000-000000000001

# IDs de Usuarios del Seed (Tenant 1)
@USER_OWNER_T1       = d1000000-0000-4000-8000-000000000001
@USER_ADMIN_T1       = d1000000-0000-4000-8000-000000000002
@USER_ACCOUNTANT_T1  = d1000000-0000-4000-8000-000000000003
@USER_WAREHOUSE_T1   = d1000000-0000-4000-8000-000000000004
@USER_CASHIER_T1     = d1000000-0000-4000-8000-000000000005

# ID de Usuario Seed (Tenant 2)
@USER_OWNER_T2       = d2000000-0000-4000-8000-000000000001

# Contrasena universal del seed
@DEFAULT_PASSWORD = Password123*

###
# =============================================================================
#  HEALTH CHECK
# =============================================================================

# @name healthCheck
GET {{BASE_URL}}/health HTTP/1.1

###
# =============================================================================
#  AUTH - Autenticacion y Sesiones
#  Base: /api/v1/auth
# =============================================================================

# @name loginOwnerTenant1
# Login: OWNER de Tech Solutions SAS
# Rate Limit: maximo 5 intentos por minuto por email
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "owner@techsolutions.com",
  "password": "{{DEFAULT_PASSWORD}}"
}

###

# @name loginAdminTenant1
# Login: ADMIN de Tech Solutions SAS
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "admin@techsolutions.com",
  "password": "{{DEFAULT_PASSWORD}}"
}

###

# @name loginAccountantTenant1
# Login: ACCOUNTANT de Tech Solutions SAS
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "accountant@techsolutions.com",
  "password": "{{DEFAULT_PASSWORD}}"
}

###

# @name loginWarehouseTenant1
# Login: WAREHOUSE_MANAGER de Tech Solutions SAS
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "warehouse@techsolutions.com",
  "password": "{{DEFAULT_PASSWORD}}"
}

###

# @name loginCashierTenant1
# Login: CASHIER de Tech Solutions SAS
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "cashier@techsolutions.com",
  "password": "{{DEFAULT_PASSWORD}}"
}

###

# @name loginOwnerTenant2
# Login: OWNER de Comercializadora Andina SAS (para validar RLS)
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "owner@andina.com",
  "password": "{{DEFAULT_PASSWORD}}"
}

###

# @name getMyProfile
# Perfil del usuario autenticado
GET {{BASE_URL}}/api/v1/auth/me HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name refreshToken
# Rotar el refresh token y obtener nuevos tokens
POST {{BASE_URL}}/api/v1/auth/refresh HTTP/1.1
Content-Type: application/json

{
  "refreshToken": "{{REFRESH_TOKEN}}"
}

###

# @name logout
# Cerrar sesion - Invalida la sesion en Redis
POST {{BASE_URL}}/api/v1/auth/logout HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###
# =============================================================================
#  TENANTS - Informacion de la Empresa
#  Base: /api/v1/tenants
# =============================================================================

# @name getCurrentTenant
# Obtener datos de la empresa actual
# Roles: OWNER ADMIN ACCOUNTANT WAREHOUSE_MANAGER CASHIER
GET {{BASE_URL}}/api/v1/tenants/current HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name createTenant
# Crear una nueva empresa
# Rol requerido: OWNER
POST {{BASE_URL}}/api/v1/tenants HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "nitRut": "900555777-3",
  "businessName": "Distribuidora Sur SAS",
  "tradeName": "Sur Market",
  "address": "Calle 50 # 30-20 Cali",
  "phone": "+573204445566",
  "email": "contacto@surmarket.com",
  "countryCode": "COL",
  "currencyCode": "COP",
  "taxRegime": "RESPONSABLE_IVA"
}

###

# @name updateCurrentTenant
# Actualizar datos de la empresa actual
# Roles: OWNER ADMIN
PATCH {{BASE_URL}}/api/v1/tenants/current HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "tradeName": "TechStore Global Pro",
  "address": "Calle 10 # 20-30 Torre A, Bogota",
  "phone": "+573001234999"
}

###

# @name deactivateCurrentTenant
# PRECAUCION: Desactivar empresa (Soft Delete) - Rol requerido: OWNER
DELETE {{BASE_URL}}/api/v1/tenants/current HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###
# =============================================================================
#  BRANCHES - Sucursales
#  Base: /api/v1/branches
# =============================================================================

# @name listBranches
# Listar todas las sucursales del tenant
# Roles: todos
GET {{BASE_URL}}/api/v1/branches HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name getBranchById
# Obtener sucursal por UUID
GET {{BASE_URL}}/api/v1/branches/{{BRANCH_1A_ID}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name getBranchByName
# Obtener sucursal por nombre
GET {{BASE_URL}}/api/v1/branches/Sede%20Principal%20Bogot%C3%A1 HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name createBranch
# Crear nueva sucursal
# Roles: OWNER ADMIN
POST {{BASE_URL}}/api/v1/branches HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "name": "Sede Occidente",
  "address": "Av. Boyaca # 64-75",
  "phone": "+573001119988",
  "isActive": true
}

###

# @name updateBranchById
# Actualizar sucursal por UUID
# Roles: OWNER ADMIN
PATCH {{BASE_URL}}/api/v1/branches/{{BRANCH_1A_ID}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "address": "Calle 10 # 20-30 Piso 3 (Actualizado)",
  "phone": "+573001234568"
}

###

# @name deleteBranch
# Eliminar sucursal (Soft Delete)
# Roles: OWNER ADMIN
DELETE {{BASE_URL}}/api/v1/branches/{{BRANCH_1B_ID}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###
# =============================================================================
#  USERS - Gestion de Usuarios
#  Base: /api/v1/users
# =============================================================================

# @name listAllUsers
# Listar todos los usuarios del tenant
GET {{BASE_URL}}/api/v1/users HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name listUsersByBranch
# Filtrar usuarios por sucursal
GET {{BASE_URL}}/api/v1/users?branch_id={{BRANCH_1A_ID}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name listUsersByRole
# Filtrar usuarios por rol
GET {{BASE_URL}}/api/v1/users?role=ACCOUNTANT HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name listUsersFiltered
# Filtrar por rol, sucursal y estado
GET {{BASE_URL}}/api/v1/users?role=CASHIER&branch_id={{BRANCH_1A_ID}}&is_active=true HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name getUserById
# Obtener usuario por UUID
GET {{BASE_URL}}/api/v1/users/{{USER_ADMIN_T1}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name createUser
# Crear nuevo usuario en el tenant
# Roles: OWNER ADMIN
POST {{BASE_URL}}/api/v1/users HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "firstName": "Laura",
  "lastName": "Gonzalez Perez",
  "documentType": "CC",
  "documentNumber": "1099887766",
  "email": "laura.gonzalez@techsolutions.com",
  "password": "Password123*",
  "phone": "+573156667788",
  "role": "ACCOUNTANT",
  "branchName": "Sede Principal Bogota"
}

###

# @name updateUserProfile
# Actualizar perfil de usuario
# Roles: OWNER ADMIN
PATCH {{BASE_URL}}/api/v1/users/{{USER_ACCOUNTANT_T1}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "fullName": "Camilo Contador Actualizado",
  "phone": "+573001113333"
}

###

# @name changeUserStatus
# Activar o desactivar usuario
# Roles: OWNER ADMIN
PATCH {{BASE_URL}}/api/v1/users/{{USER_CASHIER_T1}}/status HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "isActive": false
}

###

# @name resetUserPassword
# Resetear contrasena de usuario
# Roles: OWNER ADMIN
POST {{BASE_URL}}/api/v1/users/{{USER_ACCOUNTANT_T1}}/reset-password HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "newPassword": "NewPassword456*"
}

###

# @name changeUserRole
# Cambiar rol de usuario - Solo OWNER
PATCH {{BASE_URL}}/api/v1/users/{{USER_ACCOUNTANT_T1}}/role HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "role": "ADMIN"
}

###

# @name getUserAuditTrail
# Ver bitacora de auditoria de un usuario
# Roles: OWNER ADMIN
GET {{BASE_URL}}/api/v1/users/{{USER_OWNER_T1}}/audit-trail?page=1&limit=10 HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name deleteUser
# Eliminar usuario (Soft Delete)
# Roles: OWNER ADMIN
DELETE {{BASE_URL}}/api/v1/users/{{USER_WAREHOUSE_T1}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###
# =============================================================================
#  ESCENARIOS DE PRUEBA - RLS (Row-Level Security)
#  Validacion de aislamiento multi-tenant
# =============================================================================

# @name rlsTest_Tenant2SeeOnlyOwnData
# [RLS Test] El Tenant 2 NO debe ver usuarios ni sucursales del Tenant 1.
# Paso: Login como owner@andina.com, copia el token, y ejecuta estas peticiones.
GET {{BASE_URL}}/api/v1/users HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###

# @name rlsTest_Tenant2Branches
# [RLS Test] Branches del Tenant 2 - solo debe ver "Sede Central Medellin"
GET {{BASE_URL}}/api/v1/branches HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###
# =============================================================================
#  ESCENARIOS DE PRUEBA - RBAC (Role-Based Access Control)
# =============================================================================

# @name rbacTest_CashierForbiddenCreate
# [RBAC Test] CASHIER intenta crear usuario - esperado: 403 Forbidden
# Paso: Login como cashier@techsolutions.com y copia su token
POST {{BASE_URL}}/api/v1/users HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "Forbidden",
  "documentType": "CC",
  "documentNumber": "9999999999",
  "email": "test.forbidden@techsolutions.com",
  "password": "Password123*",
  "phone": "+573000000001",
  "role": "CASHIER"
}

###

# @name rbacTest_AccountantForbiddenDeleteBranch
# [RBAC Test] ACCOUNTANT intenta eliminar sucursal - esperado: 403 Forbidden
DELETE {{BASE_URL}}/api/v1/branches/{{BRANCH_1B_ID}} HTTP/1.1
Authorization: Bearer {{ACCESS_TOKEN}}

###
# =============================================================================
#  ESCENARIOS DE PRUEBA - Rate Limiting
#  6 intentos seguidos al mismo email -> el 6to retorna 429
# =============================================================================

# @name rateLimitAttempt1
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json
{ "email": "test.rate@fake.com", "password": "wrong" }

###
# @name rateLimitAttempt2
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json
{ "email": "test.rate@fake.com", "password": "wrong" }

###
# @name rateLimitAttempt3
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json
{ "email": "test.rate@fake.com", "password": "wrong" }

###
# @name rateLimitAttempt4
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json
{ "email": "test.rate@fake.com", "password": "wrong" }

###
# @name rateLimitAttempt5
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json
{ "email": "test.rate@fake.com", "password": "wrong" }

###
# @name rateLimitAttempt6_ShouldReturn429
# Esperado: 429 Too Many Requests
POST {{BASE_URL}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json
{ "email": "test.rate@fake.com", "password": "wrong" }

