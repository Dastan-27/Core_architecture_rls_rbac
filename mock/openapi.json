    "/health": {
      "get": {
        "description": "Verifica la conectividad con PostgreSQL y Redis. Retorna 200 si el sistema está saludable o degradado, 503 si la base de datos no está disponible.",
        "operationId": "HealthController_getHealth[0]",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Servicios saludables o degradados"
          },
          "503": {
            "description": "Servicio no disponible (BD caída)"
          }
        },
        "summary": "Health check completo",
        "tags": [
          "Health - Diagnóstico del Sistema"
        ]
      }
    },
