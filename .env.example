# ─── Entorno ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de datos (opción A: URL completa) ──────────────
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# ─── Base de datos (opción B: variables individuales) ─────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=core_rls_rbac

# ─── SSL ──────────────────────────────────────────────────
DB_SSL=false
# DB_SSL_CA=                   # Contenido PEM inline (opcional)
# DB_SSL_CA_PATH=              # Ruta al archivo .pem (opcional)

# ─── Desarrollo ──────────────────────────────────────────
DB_SYNCHRONIZE=true            # ⚠ Solo para desarrollo, nunca en producción

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-change-me
JWT_EXPIRES_IN=1h

# ─── Redis (opción A: URL completa) ─────────────────────
REDIS_URL=redis://localhost:6379

# ─── Redis (opción B: variables individuales) ────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=

# ─── Redis (Avanzado) ───────────────────────────────────
# REDIS_MAX_RETRIES=3
# REDIS_RETRY_DELAY_MS=200
# REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_COMMAND_TIMEOUT_MS=5000

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
